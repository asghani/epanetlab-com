---
interface Props {
  name: "draw" | "import" | "run" | "results" | "local" | "file";
}

const { name } = Astro.props;
---

{
  name === "draw" && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M5 9a4 4 0 1 1 8 0c0 2-1 3-2 4v3h7v2H6v-2h3v-3c-1-1-2-2-2-4Z" />
      <path d="M4 18h16v-2" stroke="currentColor" strokeWidth="1.6" fill="none" />
      <circle cx="18" cy="8" r="2" fill="none" stroke="currentColor" strokeWidth="1.6" />
    </svg>
  )
}
{
  name === "import" && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" aria-hidden="true">
      <path d="M12 3v11" />
      <path d="M8 10l4 4 4-4" />
      <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
    </svg>
  )
}
{
  name === "run" && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <path d="M10 8l6 4-6 4V8Z" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === "results" && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" aria-hidden="true">
      <path d="M4 4v16h16" />
      <path d="M8 14l3-3 3 2 5-6" />
    </svg>
  )
}
{
  name === "local" && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" aria-hidden="true">
      <path d="M12 2s7 6.3 7 11a7 7 0 0 1-14 0c0-4.7 7-11 7-11Z" />
      <circle cx="12" cy="13" r="2.5" />
    </svg>
  )
}
{
  name === "file" && (
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8" aria-hidden="true">
      <path d="M6 2h8l4 4v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z" />
      <path d="M14 2v4h4" />
    </svg>
  )
}