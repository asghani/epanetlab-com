---
import "../styles/global.css";
import Icon from "../components/Icon.astro";

const appUrl = "https://app.epanetlab.com";
const appUrlTxt = "app.epanetlab.com";
const siteUrl = "https://epanetlab.com";
const description =
  "EPANetLab is a free, local-first, browser-based hydraulic modeling tool for water distribution networks. Draw, import and simulate pipes, tanks, pumps and valves with the EPANET engine — no installs, no cloud required.";

const features = [
  {
    icon: "draw",
    title: "Draw visually",
    text: "Click to add junctions, pipes, tanks, reservoirs, pumps and valves. Auto-junctions and snap-to-pipe keep the topology clean as you draw.",
  },
  {
    icon: "import",
    title: "Import real plans",
    text: "Upload .inp files, shapefiles or DXF drawings — including fillets, arcs and splines — as editable models or colored background layers.",
  },
  {
    icon: "run",
    title: "Run simulations instantly",
    text: "Steady-state and extended-period analysis powered by the EPANET engine, running entirely in your browser via WebAssembly.",
  },
  {
    icon: "results",
    title: "See results fast",
    text: "Pressure, flow, velocity and head color-coded straight on the map. No export, no screenshots, no guesswork.",
  },
  {
    icon: "local",
    title: "Your data stays local",
    text: "Local-first by default. Projects are saved in your browser — secure, private, and working even without the cloud.",
  },
  {
    icon: "file",
    title: "EPANET file compatible",
    text: "Import and export .inp files with no conversion. Interoperable with the EPANET ecosystem you already use.",
  },
];

const audience = [
  {
    code: "W01",
    title: "Utilities & consultants",
    text: "Build fast, run local. Everything you need to get the job done — none of the feature bloat.",
  },
  {
    code: "W02",
    title: "Educators & professors",
    text: "Teach the concepts without fighting software. Students draw real networks and run sims in minutes, not hours.",
  },
  {
    code: "W03",
    title: "Students & new engineers",
    text: "Focus on learning, not software quirks. Undo/redo, auto-elevations and visual overlays help you learn water modeling quickly.",
  },
];

const faqs = [
  {
    q: "What is EPANetLab?",
    a: "EPANetLab is a browser-based hydraulic modeling tool for water distribution networks. Built on the trusted EPANET engine, it lets you draw, import, simulate and analyze your water network right in your browser — no installs, no virtual machines.",
  },
  {
    q: "Do I need to install anything?",
    a: "No. EPANetLab runs in any modern browser on Mac, Windows and Linux. It works instantly — the EPANET solver is compiled to WebAssembly and runs right in your tab.",
  },
  {
    q: "Is my data secure?",
    a: "Yes. EPANetLab is local-first: your projects are saved in your browser by default and never leave your machine unless you choose to sync them.",
  },
  {
    q: "Can I import my existing EPANET files?",
    a: "Yes. Import .inp files, or go straight from GIS by uploading shapefiles and DXF drawings — including curves like fillet arcs and splines — as editable models or background layers.",
  },
  {
    q: "Can I export to .inp?",
    a: "Absolutely. The .inp exporter writes your model in standard EPANET format, so you can move between EPANetLab and other tools freely.",
  },
  {
    q: "How much does it cost?",
    a: "EPANetLab is free to use. If premium features are added later, pricing will be announced then — the core modeling experience stays free.",
  },
];

// Network diagram drawn as decorative "piping" for the hero / CTA backdrop.
const heroNodes = [
  [118, 126, 10],
  [302, 64, 14],
  [470, 176, 11],
  [598, 96, 9],
  [724, 198, 13],
  [876, 118, 10],
  [252, 268, 11],
  [428, 254, 14],
  [622, 300, 10],
  [828, 306, 12],
] as const;

const heroLinks = [
  [0, 1, 96],
  [1, 2, 104],
  [2, 3, 40],
  [3, 4, 88],
  [4, 5, 32],
  [1, 6, 100],
  [6, 7, 56],
  [2, 7, 92],
  [7, 8, 24],
  [8, 4, 72],
  [8, 9, 44],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>EPANetLab — Browser-based hydraulic modeling for water networks</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#060b17" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EPANetLab" />
    <meta property="og:title" content="EPANetLab — Browser-based hydraulic modeling for water networks" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={siteUrl + "/logo.png"} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="EPANetLab — Browser-based hydraulic modeling for water networks" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + "/logo.png"} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "EPANetLab",
      url: siteUrl,
      applicationCategory: "ScientificApplication",
      operatingSystem: "Web",
      browserRequirements: "Requires a modern web browser",
      description,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      featuredLocation: { "@type": "Place", name: "Online" },
      author: {
        "@type": "Organization",
        name: "EPANetLab",
        url: siteUrl,
      },
    })} />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/">
          <img src="/logo.png" alt="EPANetLab logo" width="32" height="32" />
          <span>EPANetLab<span class="brand-dot">.com</span></span>
        </a>
        <nav aria-label="Main">
          <ul class="nav-links">
            <li><a href="#features">Features</a></li>
            <li><a href="#founder">Founder</a></li>
            <li><a href="#faq">FAQ</a></li>
          </ul>
        </nav>
        <div class="nav-right">
          <span class="live-chip"><span class="dot" aria-hidden="true"></span> Live</span>
          <a class="btn btn-primary" href={appUrl} target="_blank" rel="noopener">
            Launch the app
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- ============================= HERO ============================= -->
      <section class="hero">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="container">
          <span class="badge">
            <span class="dot" aria-hidden="true"></span> Live now — free, no account needed
          </span>
          <h1>
            Hydraulic modeling in your browser, <span class="hl">on the EPANET engine</span>.
          </h1>
          <p class="sub">
            Draw, import and simulate water distribution networks in minutes —
            local-first, secure and free. No installs. No cloud required.
          </p>
          <div class="cta-row">
            <a class="btn btn-primary btn-lg" href={appUrl} target="_blank" rel="noopener">
              Start modeling at {appUrlTxt}
            </a>
            <a class="btn btn-ghost btn-lg" href="#features">See what it does</a>
          </div>
          <p class="hero-meta">Steady-state &amp; extended-period simulation · in-browser wasm · .inp import/export</p>
        </div>

        <div class="hero-diagram" aria-hidden="true">
          <svg viewBox="0 0 1000 360" class="pipe-svg">
            <defs>
              <linearGradient id="dash" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#22d3ee" stop-opacity="0.7" />
                <stop offset="1" stop-color="#0ea5e9" stop-opacity="0.15" />
              </linearGradient>
            </defs>
            {
              heroLinks.map(([a, b, delay]) => {
                const [x1, y1] = heroNodes[a]!;
                const [x2, y2] = heroNodes[b]!;
                return (
                  <line
                    x1={x1} y1={y1} x2={x2} y2={y2}
                    stroke="url(#dash)" stroke-width="2" stroke-dasharray="3 7"
                    style={`animation: flow 9s linear infinite; animation-delay: -${delay}s`}
                  />
                );
              })
            }
            {
              heroNodes.map(([cx, cy, r]) => (
                <g>
                  <circle cx={cx} cy={cy} r={r} fill="#0b1424" stroke="#164e63" stroke-width="1.5" />
                  <circle cx={cx} cy={cy} r={3.5} fill="#22d3ee" opacity="0.9" />
                </g>
              ))
            }
          </svg>
        </div>
      </section>

      <!-- =========================== FEATURES =========================== -->
      <section class="section" id="features">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Features</span>
            <h2>Built for working, not troubleshooting</h2>
            <p>
              An intuitive, modern interface that gets you to answers quickly —
              on top of the trusted EPANET engine.
            </p>
          </div>
          <div class="feature-grid">
            {
              features.map((f, i) => (
                <article class="card">
                  <div class="card-idx mono">0{i + 1}</div>
                  <div class="icon">
                    <Icon name={f.icon} />
                  </div>
                  <h3>{f.title}</h3>
                  <p>{f.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- =========================== AUDIENCE =========================== -->
      <section class="section section-dark" id="audience">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">Who it's for</span>
            <h2>One tool for the whole water community</h2>
          </div>
          <div class="audience-grid">
            {
              audience.map((a) => (
                <article class="spec">
                  <div class="spec-code">{a.code}</div>
                  <h3>{a.title}</h3>
                  <p>{a.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- ============================ FOUNDER =========================== -->
      <section class="section" id="founder">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">About the founder</span>
            <h2>Built by an engineer who works in the field</h2>
          </div>
          <div class="founder-card">
            <img
              src="/founder.png"
              alt="Founder of EPANetLab, a water and wastewater design engineer"
              class="founder-photo"
              width="360"
              height="360"
              loading="lazy"
            />
            <div class="founder-body">
              <span class="tag">Founder &amp; Engineer</span>
              <p>
                EPANetLab was founded by a passionate water, wastewater, and
                drainage design engineer dedicated to modernizing civil
                infrastructure workflows. With a strong technical background in
                environmental engineering and spatial data integration, the
                founder built EPANetLab to bring fast, local-first, and
                browser-based hydraulic modeling directly to engineers,
                utilities, and students — bridging the gap between complex
                engineering calculations and clean, modern web software.
              </p>
              <div class="founder-calls">
                <span>Water · wastewater · drainage design</span>
                <span>Environmental engineering + spatial data</span>
                <span>Modern hydraulic software for everyone</span>
              </div>
              <a
                class="btn btn-ghost founder-linkedin"
                href="https://www.linkedin.com/in/ahmadshahidghani"
                target="_blank"
                rel="noopener"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0z" />
                </svg>
                Connect on LinkedIn
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================= CTA ============================= -->
      <section class="section section-dark" id="launch">
        <div class="container">
          <div class="cta-banner">
            <span class="eyebrow eyebrow-light">Ready when you are</span>
            <h2>Just open your browser and model.</h2>
            <p>
              No installs, no logins, no cloud required. EPANetLab runs right
              in your tab — launch the app and draw your first network today.
            </p>
            <a class="btn btn-light" href={appUrl} target="_blank" rel="noopener">
              Launch at {appUrlTxt}
            </a>
          </div>
        </div>
      </section>

      <!-- ============================== FAQ ============================= -->
      <section class="section" id="faq">
        <div class="container">
          <div class="section-head">
            <span class="eyebrow">FAQ</span>
            <h2>Frequently asked questions</h2>
          </div>
          <ul class="faq">
            {faqs.map((f) => (
              <li>
                <details>
                  <summary>{f.q}</summary>
                  <p>{f.a}</p>
                </details>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-top">
          <div>
            <div class="footer-brand">
              <img src="/logo.png" alt="" width="28" height="28" />
              <span>EPANetLab<span class="brand-dot">.com</span></span>
            </div>
            <p>
              A browser-based hydraulic modeling tool for water distribution
              networks. Local-first and free.
            </p>
          </div>
          <div class="footer-col">
            <h4>Product</h4>
            <a href="#features">Features</a>
            <a href="#founder">Founder</a>
            <a href="#faq">FAQ</a>
          </div>
          <div class="footer-col">
            <h4>App</h4>
            <a href={appUrl} target="_blank" rel="noopener">{appUrlTxt}</a>
          </div>
          <div class="footer-col">
            <h4>Powered by</h4>
            <a href="https://epanetjs.com" target="_blank" rel="noopener">EPANet.js solver</a>
            <a href="https://maplibre.org" target="_blank" rel="noopener">MapLibre</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} EPANetLab. All rights reserved.</span>
          <span>v0.1.0 · Modern water modeling</span>
        </div>
      </div>
    </footer>
  </body>
</html>