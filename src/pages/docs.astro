---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Analytics from "@vercel/analytics/astro";

const appUrl = "https://app.epanetlab.com";
const appUrlTxt = "app.epanetlab.com";
const siteUrl = "https://epanetlab.com";
const docsUrl = "https://epanetlab.com/docs/";
const description =
  "Complete user guide for EPANetLab, the free browser-based hydraulic modeling tool. Covers drawing networks, importing shapefiles and DXF, running simulations, and reading results.";

const toc = [
  { id: "overview", label: "Overview" },
  { id: "quick-start", label: "Quick Start" },
  { id: "interface", label: "Interface Tour" },
  { id: "drawing", label: "Drawing Tools" },
  { id: "properties", label: "Setting Properties" },
  { id: "simulation", label: "Hydraulic Simulation" },
  { id: "flex-table", label: "Flex Table" },
  { id: "import", label: "Import & Positioning" },
  { id: "export", label: "Export" },
  { id: "save-load", label: "Save, Load & Cloud Sync" },
  { id: "views", label: "Views & Appearance" },
  { id: "search", label: "Searching for Places" },
  { id: "command-line", label: "The Command Line" },
  { id: "shortcuts", label: "Keyboard Shortcuts" },
  { id: "ai-assistant", label: "AI Assistant" },
  { id: "privacy", label: "Privacy" },
  { id: "faq", label: "FAQ & Troubleshooting" },
  { id: "roadmap", label: "Getting Help & Roadmap" },
];

const tools = [
  ["Select", "Select / inspect / drag elements. Hold Shift for multi-select; rubber-band drag selects a box of elements."],
  ["Junction (J-)", "A consumption node. Set its elevation and base demand."],
  ["Meter (M-)", "A customer meter — connects to pipes and carries a demand."],
  ["Demand Ctr (DC-)", "A demand center — a spatial load zone whose demand is allocated to the nearest pipe end junctions."],
  ["Tank (T-)", "A storage tank. Set elevation, initial / min / max level, and diameter."],
  ["Reservoir (R-)", "An infinite supply source. Set its total head."],
  ["Pipe (P-)", "Draws pipes. Three modes: chain (click junction to junction), straight (LINE, 2 clicks), polyline (PLINE, with bends)."],
  ["Pump (PU-)", "Connects two nodes with a pump. Set its power."],
  ["Valve (V-)", "Connects two nodes with a valve. Set diameter, type, and setting."],
  ["Ruler", "Measure distances — click points; double-click to finish. Shows a running total on the map and status bar."],
  ["Delete", "Delete an element (Delete / Backspace also works in Select mode)."],
];

const commands = [
  ["HELP", "H, ?", "Show help"],
  ["ERASE", "E, DEL, DELETE", "Delete selection"],
  ["SELECT", "SEL", "Select elements"],
  ["SELECTALL", "ALL, SELALL", "Select everything"],
  ["DESELECT", "DESEL, NONE", "Clear selection"],
  ["COPY", "CO, CP", "Copy selection"],
  ["PASTE", "PA", "Paste"],
  ["MOVE", "MO, M", "Move selection"],
  ["STRETCH", "STR", "Stretch"],
  ["OFFSET", "OFF, O", "Offset pipes"],
  ["MERGE", "—", "Collapse nearby nodes"],
  ["SPLIT", "—", "Splice a node onto a pipe"],
  ["LINE", "L, LI", "Straight 2-click pipe"],
  ["PLINE", "PL, POLYLINE", "Polyline pipe with bends"],
  ["BEND", "ADDBEND", "Add a bend vertex"],
  ["REMOVEBEND", "—", "Remove a bend vertex"],
  ["FLATTEN", "REMOVEBENDS", "Remove all bends on a pipe"],
  ["UNDO", "U", "Undo"],
  ["REDO", "—", "Redo"],
  ["REGEN", "REG", "Regenerate view"],
  ["ZOOM", "Z", "in / out / extents / window"],
  ["ZOOMIN / ZOOMOUT / ZOOMEXTENTS / ZOOMWINDOW", "ZI / ZO / ZE / ZW", "Zoom helpers"],
  ["RULER", "DI, DIST, MEASURE", "Measure"],
  ["UNITS", "UN, UNIT", "Switch SI / US"],
  ["BASEMAP", "BASE, BM", "streets / satellite / blank"],
  ["NORTH", "RN, N", "North-up view"],
  ["PAN", "P", "Pan"],
  ["SAVE", "—", "Save project"],
  ["EXPORT", "SAVEAS", "Export project file"],
  ["IMPORT", "OPEN", "Import project file"],
  ["DXFIN", "—", "Import a CAD drawing (.dxf) and position it"],
  ["DXFOUT", "—", "Export a CAD drawing (.dxf) with annotations"],
  ["KMLIN", "—", "Import a Google Earth KML/KMZ file"],
  ["KMLOUT", "—", "Export the layout as .kml"],
  ["KMZOUT", "—", "Export the layout as zipped .kmz"],
  ["SHPIN", "—", "Import an ESRI shapefile (.shp/.dbf/.shx/.prj or .zip)"],
  ["SHPOUT", "—", "Export the network as ESRI shapefiles (.zip)"],
  ["CLEAR", "CLS", "Clear network"],
  ["EXIT", "QUIT, CLOSE", "Close"],
];

const shortcuts = [
  ["Esc", "End a pipe run or dismiss the command line (1×); return to Select (2×)"],
  ["Delete / Backspace", "Delete selection"],
  ["Ctrl/Cmd + Z", "Undo"],
  ["Ctrl/Cmd + Shift + Z or Ctrl/Cmd + Y", "Redo"],
  ["Ctrl/Cmd + A", "Select all"],
  ["Ctrl/Cmd + S", "Save project"],
  ["R", "North-up view"],
  ["/", "Open the command line"],
  ["Space", "Repeat last command"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>Documentation — EPANetLab</title>
    <Analytics />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DYJ6PW4HG2"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-DYJ6PW4HG2');
    </script>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#060b17" />
    <link rel="canonical" href={docsUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EPANetLab" />
    <meta property="og:title" content="Documentation — EPANetLab" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={docsUrl} />
    <meta property="og:image" content={siteUrl + "/logo.png"} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Documentation — EPANetLab" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={siteUrl + "/logo.png"} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      headline: "EPANetLab Documentation",
      description,
      url: docsUrl,
      author: { "@type": "Organization", name: "EPANetLab", url: siteUrl },
      publisher: { "@type": "Organization", name: "EPANetLab", url: siteUrl, logo: { "@type": "ImageObject", url: siteUrl + "/logo.png" } },
    })} />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/">
          <img src="/logo.png" alt="EPANetLab logo" width="32" height="32" />
          <span>EPANetLab<span class="brand-dot">.com</span></span>
        </a>
        <nav aria-label="Main">
          <ul class="nav-links">
            <li><a href="/#features">Features</a></li>
            <li><a href="/#founder">Founder</a></li>
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/docs/" class="nav-active">Docs</a></li>
          </ul>
        </nav>
        <div class="nav-right">
          <span class="live-chip"><span class="dot" aria-hidden="true"></span> Live</span>
          <a class="btn btn-primary" href={appUrl} target="_blank" rel="noopener">
            Launch the app
          </a>
        </div>
      </div>
    </header>

    <div class="docs">
      <aside class="docs-toc" aria-label="Documentation contents">
        <div class="toc-inner">
          <span class="eyebrow">User Guide</span>
          <nav>
            {toc.map((t, i) => (
              <a href={`#${t.id}`}><span class="toc-num">{String(i + 1).padStart(2, "0")}</span>{t.label}</a>
            ))}
          </nav>
        </div>
      </aside>

      <main class="docs-body">
        <span class="eyebrow">EPANetLab</span>
        <h1>User documentation</h1>
        <p class="docs-lede">
          A browser-based hydraulic modeling tool for water distribution networks. It runs the
          EPANET 2.2 solver (compiled to WebAssembly) entirely in your browser — no installation,
          no servers, and no account needed for local work.
        </p>

        <!-- 1. Overview -->
        <section id="overview" class="docs-section">
          <h2>1. Overview</h2>
          <p>
            EPANetLab lets you draw a water distribution network on a real map, set the properties
            of every element, run a steady-state hydraulic simulation, and see the results
            color-coded across the map.
          </p>
          <h3>Key capabilities</h3>
          <ul>
            <li>Draw and edit junctions, pipes, tanks, reservoirs, pumps, valves, meters and demand centers on a MapLibre map.</li>
            <li>Import shapefiles, DXF drawings, and CSV junction lists as editable models.</li>
            <li>Import terrain (TREX / LandXML / DXF) to auto-assign ground elevations.</li>
            <li>Run the EPANET 2.2 steady-state solver in-browser via a Web Worker.</li>
            <li>Visualize pressure (node circles) and flow (link colors) with legends.</li>
            <li>Edit element properties and results in a spreadsheet-style Flex Table.</li>
            <li>Save projects to browser storage, or sign in to sync them to the cloud.</li>
            <li>Export EPANET <code>.inp</code>, project JSON, and node-position CSV.</li>
            <li>Control nearly everything from an AutoCAD-style command line.</li>
            <li>Use an optional AI assistant (free, no key needed) to build, edit, and analyze the model.</li>
            <li>Switch units (SI / US), basemaps (Streets / Satellite / Blank), themes, and label overlays.</li>
          </ul>
          <h3>What it is not</h3>
          <ul>
            <li>EPANetLab runs <b>steady-state analysis only</b> — no extended-period (time-series) simulation yet.</li>
            <li>Results are <b>not stamped or sealed</b>; the tool is not a substitute for engineer review and sign-off.</li>
            <li>No model data is uploaded for ordinary use; the AI assistant talks only to the provider you choose.</li>
          </ul>
        </section>

        <!-- 2. Quick Start -->
        <section id="quick-start" class="docs-section">
          <h2>2. Quick Start — first network in 60 seconds</h2>
          <ol>
            <li>Open <a href={appUrl} target="_blank" rel="noopener">{appUrlTxt}</a>.</li>
            <li>On the <b>Layout</b> toolbar, click <b>Reservoir</b> and place it on the map.</li>
            <li>Click <b>Junction</b> and place 3–4 junctions in a line downhill from the reservoir.</li>
            <li>Click <b>Pipe</b>, then click the reservoir and each junction in turn (a chained run). Press <b>Esc</b> once to finish the run.</li>
            <li>Click <b>Run</b> (top-right). The map fills with colored results.</li>
            <li>Open the right-hand <b>Results</b> panel to see min/max pressure, total demand, peak flow, and peak velocity.</li>
          </ol>
          <p>
            The default pipe diameter is 75&nbsp;mm (SI) or 3&nbsp;in (US); default roughness is
            Hazen-Williams C. Change any of these in the Properties panel.
          </p>
        </section>

        <!-- 3. Interface -->
        <section id="interface" class="docs-section">
          <h2>3. Interface Tour</h2>
          <h3>Toolbar (top)</h3>
          <p>
            Three tabs — <b>Layout</b>, <b>Project</b>, <b>View</b> — plus a right-side group that
            is always visible: the AI assistant toggle, <b>Run</b>, and Clear network.
          </p>
          <h3>Left panel (Properties / Backgrounds / Symbology / Flex Table)</h3>
          <p>
            Switched with the four-icon rail on the far left:
            <b>Properties</b> (network summary or the selected element's form, plus its simulation
            results), <b>Backgrounds</b> (non-editable reference layers), <b>Symbology</b>
            (annotation toggles and pipe color ranges), and <b>Flex Table</b> (all elements in a
            spreadsheet). At most one panel is open at a time; on small screens they become overlays.
          </p>
          <h3>Results panel (right)</h3>
          <p>Summary cards, pressure legend, simulation status, and Clear results.</p>
          <h3>Map area</h3>
          <p>
            Interactive map with the floating <b>Search</b> box (top-left) and the
            <b>Command Line</b> (bottom).
          </p>
          <h3>Status bar (bottom)</h3>
          <p>Current tool, node/link counts, terrain name, ruler readout, selection count, and shortcut hints.</p>
        </section>

        <!-- 4. Drawing -->
        <section id="drawing" class="docs-section">
          <h2>4. Drawing Tools (Layout tab)</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Tool</th><th>What it does</th></tr></thead>
              <tbody>
                {tools.map(([name, desc]) => (
                  <tr><td class="mono tool-name">{name}</td><td>{desc}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>
            <b>Pipes:</b> in the default chain mode, each click places a new junction and chains a
            pipe to it. Press <b>Esc</b> once to end a run; twice returns to Select. Pipe bends are
            shown as drag handles; use the <code>BEND</code>, <code>REMOVEBEND</code>, and
            <code>FLATTEN</code> commands to manage bend vertices.
          </p>
          <p>
            <b>Snapping:</b> clicks near an existing node snap to it automatically, so pipes connect
            cleanly and duplicate nodes merge.
          </p>
        </section>

        <!-- 5. Properties -->
        <section id="properties" class="docs-section">
          <h2>5. Setting Properties</h2>
          <p>Select an element on the map and edit it in the <b>Properties</b> panel:</p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Element</th><th>Editable properties</th></tr></thead>
              <tbody>
                <tr><td class="mono">Junction</td><td>Elevation, Base demand</td></tr>
                <tr><td class="mono">Meter</td><td>Elevation, Customer demand</td></tr>
                <tr><td class="mono">Demand Ctr</td><td>Total demand (allocated to nearest pipe ends)</td></tr>
                <tr><td class="mono">Tank</td><td>Elevation, Initial level, Min level, Max level, Diameter</td></tr>
                <tr><td class="mono">Reservoir</td><td>Total head</td></tr>
                <tr><td class="mono">Pipe</td><td>Length, Diameter, Roughness (Hazen-Williams C)</td></tr>
                <tr><td class="mono">Pump</td><td>Power</td></tr>
                <tr><td class="mono">Valve</td><td>Diameter, Type (PRV / PSV / PBV / FCV / TCV / GPV), Setting</td></tr>
              </tbody>
            </table>
          </div>
          <p>
            Values are typed in the units set in the View tab (SI or US) and converted internally.
            Element IDs use friendly prefixes (J-, M-, DC-, T-, R-, P-, PU-, V-) with incrementing numbers.
          </p>
        </section>

        <!-- 6. Simulation -->
        <section id="simulation" class="docs-section">
          <h2>6. Hydraulic Simulation</h2>
          <p>
            Click <b>Run</b> (top-right) to run a steady-state analysis. The solver has a 30-second
            timeout; a network needs <b>at least one reservoir or tank</b> and <b>at least one pipe</b>.
          </p>
          <h3>Results you get</h3>
          <ul>
            <li><b>Per node:</b> pressure, head, demand (negative demand = inflow at the source).</li>
            <li><b>Per link:</b> flow, velocity, head loss.</li>
            <li><b>Results panel cards:</b> Min pressure, Max pressure, Total demand, Peak flow, Peak velocity.</li>
            <li><b>Status:</b> Ready / Running / Converged / warnings / error; the raw solver report is captured internally.</li>
          </ul>
          <h3>Map visualization</h3>
          <ul>
            <li>Junction colors encode pressure: &lt;20 red, 20–40 orange, 40–70 yellow, 70–100 green, &gt;100 blue.</li>
            <li>Link colors encode flow magnitude (5-step blue ramp).</li>
            <li>
              Optional thematic pipe coloring (Symbology tab) tints pipes by diameter, velocity,
              flow, or head loss against user-defined color ranges — otherwise pipes stay
              kind-colored (blue) or flow-colored after a run.
            </li>
            <li>Node IDs appear from zoom 14; link IDs from zoom 15.</li>
          </ul>
          <h3>Reading the results</h3>
          <p>
            "Simulation completed with warnings" — a banner appears; open the report or inspect
            low-pressure nodes. Use the Results panel legend to judge whether pressures fall in an
            acceptable service range for the scenario being studied.
          </p>
        </section>

        <!-- 7. Flex Table -->
        <section id="flex-table" class="docs-section">
          <h2>7. Flex Table (spreadsheet editing)</h2>
          <p>
            Open the <b>Flex Table</b> from the left rail. It has tabs for
            <b>Junctions, Tanks, Reservoirs, Pipes, Pumps, Valves</b>.
          </p>
          <ul>
            <li>Click any value cell to edit inline.</li>
            <li><b>Enter</b> / <b>↓</b> moves down; <b>Esc</b> cancels.</li>
            <li>Columns show geometry and results (Pipes: Length, Diameter, Roughness C, Flow, Velocity — Junctions: Elevation, Demand, Pressure, Longitude, Latitude).</li>
            <li>Sort any column by its header; use the "Filter rows…" box to find elements.</li>
            <li>Double-click a row to zoom to that element; Shift/Ctrl for multi-select.</li>
            <li>If a terrain surface is loaded, an "Apply elevations" action appears.</li>
          </ul>
        </section>

        <!-- 8. Import -->
        <section id="import" class="docs-section">
          <h2>8. Import & Positioning</h2>
          <p>All imports live on the <b>Project</b> tab.</p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Feature</th><th>Files</th><th>Result</th></tr></thead>
              <tbody>
                <tr><td class="mono">Import shapefile</td><td>.zip / .shp/.dbf/.shx/.prj/.cpg</td><td>Points become junctions, lines become pipes — an editable network, then the camera fits</td></tr>
                <tr><td class="mono">Import DXF</td><td>.dxf</td><td>Same as shapefile; arcs are tessellated into pipe bends</td></tr>
                <tr><td class="mono">Import KML / KMZ</td><td>.kml / .kmz</td><td>Google Earth layouts: Points become junctions, LineStrings become pipes, Polygon rings become boundary lines</td></tr>
                <tr><td class="mono">Import CSV</td><td>.csv</td><td>Junctions from Label/X/Y/Elevation/Demand columns</td></tr>
                <tr><td class="mono">Load Builder</td><td>.csv / .txt</td><td>Assign demands to junctions / meters / demand centers</td></tr>
                <tr><td class="mono">TERRAIN (TREX)</td><td>.xml / .landxml / .dxf</td><td>Terrain TIN surface; auto-assigns junction ground elevations</td></tr>
                <tr><td class="mono">Open project</td><td>.json</td><td>Full project restore (validated)</td></tr>
              </tbody>
            </table>
          </div>
          <h3>Positioning dialog</h3>
          <p>
            Files already in WGS84 lat/lon — shapefiles with a <code>.prj</code>, and KML/KMZ
            (which are always lon/lat by the Google Earth spec) — import directly and are framed.
            Projected files (unitless DXF, shapefiles without a <code>.prj</code>, or KML from
            engineering tools that emit meters) open the <b>Position file</b> dialog: choose a UTM
            zone 1–60 (or "Use current map location"), hemisphere, and units; then import. Terrain
            adds a <b>"Fit to network"</b> option and an <b>Apply elevations</b> step later.
          </p>
          <p>
            You don't have to guess the zone when <em>exporting</em>: EPANetLab derives the zone
            your drawing sits in, shows it in the status bar (e.g. <code>UTM 43N</code>), and writes
            the drawing as real UTM meters with that zone tagged in the DXF header. Import that DXF
            back — even in a fresh session — and the dialog is pre-filled with the zone the file
            declares, so a network you export here re-imports exactly where it was.
          </p>
          <p>
            The same commands work from the command line: <code>DXFIN</code> imports a drawing and
            <code>KMLIN</code> imports a KML/KMZ layout.
          </p>
          <h3>Background layers (non-editable)</h3>
          <p>
            From the <b>Backgrounds</b> panel you can also add shapefile / DXF layers strictly as
            reference (water mains, cadastral maps). Each layer has show/hide, a color picker,
            opacity, zoom-to-layer, and remove. Polygons from imports become ring outlines.
          </p>
          <p class="note">
            Importing an EPANET <code>.inp</code> file is not yet supported (<code>.inp</code> is
            generated internally for the solver and available for export). Use a shapefile, DXF, or
            CSV, or re-draw.
          </p>
        </section>

        <!-- 9. Export -->
        <section id="export" class="docs-section">
          <h2>9. Export</h2>
          <h3>EPANET .inp</h3>
          <p>
            <b>Project → Export EPANET .inp</b> downloads <code>epanetlab.inp</code>, honoring your
            unit system (flow keyword LPS for SI, CFS for US). Meters are exported as standard
            junctions; demand centers are allocated to the nearest pipe end junctions.
          </p>
          <h3>Project JSON</h3>
          <p>
            <b>Export</b> saves the full project (nodes, links, basemap, backgrounds, units) as a
            shareable JSON snapshot you can re-import later. Terrain surfaces are not included.
          </p>
          <h3>Node positions CSV</h3>
          <p>
            Exports <code>Label, X, Y, Type, Elevation_m, Demand_LPS</code> — designed to bring node
            positions into AutoCAD for labeling.
          </p>
          <h3>CAD drawing (DXF)</h3>
          <p>
            <b>Export CAD (DXF)</b> in the toolbar — or the <code>DXFOUT</code> command — downloads a
            DXF R12 drawing in meters. Junctions become <code>POINT</code>s, tanks and reservoirs
            <code>CIRCLE</code>s, and pipes/pumps/valves <code>LINE</code>s on their own layers. The
            annotation toggles from the Symbology tab control the <code>TEXT</code> entities: pipe
            labels ("D 6.0 mm", "L 100.0 m", flow, velocity, head loss) sit at each pipe's midpoint,
            junction labels/elevation/pressure/demand at each node, each property on its own
            <code>ANN.*</code> layer. When thematic pipe coloring is active, pipe lines are tinted
            to the nearest CAD color.
          </p>
          <h3>Google Earth (KML / KMZ)</h3>
          <p>
            <b>Export KML</b> in the toolbar — or <code>KMLOUT</code> / <code>KMZOUT</code> —
            downloads the layout as a standard lon/lat <code>.kml</code> (or a zipped
            <code>.kmz</code>). Every node becomes a <code>Point</code> placemark and every link a
            <code>LineString</code> placemark. Each placemark's description carries the same
            annotation text the map shows, and thematic pipe ranges set the line colors — handy for
            reviewing the model in Google Earth or sharing a layout with non-Hydraulic viewers.
          </p>
          <h3>GIS shapefile (SHPIN / SHPOUT)</h3>
          <p>
            <b>Export shapefile</b> — the <code>SHPOUT</code> command (or the Export menu) — downloads a
            zipped pair of ESRI shapefiles: <code>…_points</code> (junctions, meters, demand centers,
            tanks, reservoirs) and <code>…_lines</code> (pipes — bends become multi-vertex polylines —
            plus pumps and valves). Each set ships its <code>.shx</code> index, a <code>.dbf</code>
            attribute table (type, label, and for lines from/to node tags, diameter, length, roughness,
            and pump power / valve setting), and a <code>.prj</code> written for the network's UTM zone.
            The coordinates are real easting/northing — the same meter frame as the DXF export — so the
            layout lands at its true position in QGIS / ArcGIS / AutoCAD Map 3D.
          </p>
          <p>
            <b>Import shapefile</b> — the toolbar button or <code>SHPIN</code> — accepts a
            <code>.zip</code> or the <code>.shp/.dbf/.shx/.prj</code> set. When a <code>.prj</code> is
            present the coordinates are reprojected to lon/lat and placed automatically; a bare
            <code>.shp</code> without one opens the positioning dialog. A zip from <code>SHPOUT</code>
            re-imports exactly where it was exported.
          </p>
        </section>

        <!-- 10. Save/Load -->
        <section id="save-load" class="docs-section">
          <h2>10. Save, Load & Cloud Sync</h2>
          <ul>
            <li><b>Autosave:</b> your working session is continuously saved (500 ms debounce, also flushed when you leave the tab) and restored on the next open.</li>
            <li><b>Named projects:</b> Save prompts for a name; Load lists them; delete from the list. Stored in browser storage.</li>
            <li><b>Cloud sync:</b> sign in to sync projects to the cloud (Supabase + PostGIS) — Load then merges local and cloud projects.</li>
          </ul>
          <h3>Signing in</h3>
          <ol>
            <li>Click <b>☁ Sign in</b> in the toolbar.</li>
            <li>Enter your email — you receive a 6-digit code / magic link (no password).</li>
            <li>Signed-in state shows as <b>☁ your-email</b>; click it to sign out.</li>
          </ol>
          <p>
            Cloud sync is optional; all drawing, simulation, and local save work without an account.
            Synced networks also enable spatial queries for the AI assistant.
          </p>
        </section>

        <!-- 11. Views -->
        <section id="views" class="docs-section">
          <h2>11. Views & Appearance</h2>
          <ul>
            <li><b>Basemaps</b> (View tab): Streets (OSM), Satellite (Esri imagery), or Blank.</li>
            <li><b>Place-name labels overlay:</b> an optional label layer above the basemap but under the network.</li>
            <li><b>Units:</b> SI (m, mm, cumec) or US (ft, in, cusec, psi). Stored internally as SI, converted for display; applies to drawing, properties, results, and .inp export.</li>
            <li><b>Themes:</b> Light / Dark / Auto (system), plus 9 accent presets or a custom color. Persisted and applied before first paint to avoid flashing.</li>
          </ul>
          <h3>Symbology panel (WaterGEMS-style)</h3>
          <p>
            The <b>Symbology</b> panel (fourth icon on the left rail) controls what the map labels
            and how pipes are colored:
          </p>
          <ul>
            <li><b>Pipe annotations:</b> diameter, length, flow, velocity, head loss — each a toggle. Simulation-dependent ones need a completed run.</li>
            <li><b>Junction annotations:</b> label, elevation, pressure, demand — again all toggles.</li>
            <li><b>Pipe color by range:</b> pick a property (diameter, length, roughness, velocity, flow, head loss) and define min/max/color bands, like "3 in → blue, 4 in → green, 6 in → yellow". Values outside every band use the "Outside ranges" color.</li>
            <li><b>Junction color by range:</b> the same for nodes — color them by elevation, pressure, demand, or head over min/max/color bands. This takes over from the automatic pressure gradient, so you see exactly the ranges you defined.</li>
            <li><b>Auto ranges:</b> instead of typing bands by hand, choose a class count (3–6) and press <b>Auto</b> — the network is split into equal-count classes across the chosen property, with the standard blue→green→yellow→orange→red ramp. A swatch legend under the ranges shows each band and its value, in the current unit system.</li>
          </ul>
          <p>
            The same toggles and color ranges drive the DXF and KML exports, so a drafting sheet or
            Google Earth file shows exactly the labels and colors you see on screen. A junction theme
            also puts nodes on a separate <code>JUNCTIONS-THEMED</code> DXF layer so themed elements
            can be styled or frozen independently in CAD.
          </p>
        </section>

        <!-- 12. Search -->
        <section id="search" class="docs-section">
          <h2>12. Searching for Places</h2>
          <p>
            Use the <b>Search</b> box (top-left, "Search places (powered by OSM)"). Type a place
            name, press Enter, and pick one of up to 6 results — the map flies to it. This uses the
            public OpenStreetMap Nominatim geocoder. The Flex Table has its own "Filter rows…" box
            for finding elements.
          </p>
        </section>

        <!-- 13. Command Line -->
        <section id="command-line" class="docs-section">
          <h2>13. The Command Line</h2>
          <p>
            An AutoCAD-style prompt sits at the bottom of the map. Press any character (or <code>/</code>)
            to start typing; <b>Enter</b> runs, <b>↑ / ↓</b> scrolls suggestions and history,
            <b>Tab</b> completes, <b>Esc</b> exits.
          </p>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Command</th><th>Aliases</th><th>Purpose</th></tr></thead>
              <tbody>
                {commands.map(([cmd, aliases, purpose]) => (
                  <tr><td class="mono">{cmd}</td><td class="mono">{aliases}</td><td>{purpose}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
          <p><b>Space</b> repeats the last command (AutoCAD behavior); typing most keys opens the command line.</p>
        </section>

        <!-- 14. Shortcuts -->
        <section id="shortcuts" class="docs-section">
          <h2>14. Keyboard Shortcuts</h2>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Keys</th><th>Action</th></tr></thead>
              <tbody>
                {shortcuts.map(([keys, action]) => (
